<!DOCTYPE html>
<html lang="en">
<!--begin::Head-->
<head>
    <partial name="_Head" />
    @RenderSection("header", required: false)
</head> 
<!--end::Head--> 

<!--begin::Body-->
<body class="layout-fixed sidebar-expand-lg sidebar-mini sidebar-collapse bg-body-tertiary">
    <!--begin::App Wrapper-->
    <div class="app-wrapper">
        <!--begin::Header-->
        <partial name="_Header" />
        <!--end::Header-->

        <!--begin::Sidebar-->
        <partial name="_Sidebar" />
        <!--end::Sidebar-->

        <!--begin::App Main-->
        <main class="app-main">
            @RenderBody()
        </main> 
        <!--end::App Main-->
    </div> <!--end::App Wrapper-->

    <!--begin::Script--> 
    <partial name="_Script" />
    @RenderSection("Scripts", required: false)
    <!--end::Script-->
</body>
<!--end::Body-->
</html>
@model DTech.Models.EF.Product

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.mainPage = "information";
    ViewBag.page = "product";
}

<!--begin::App Content Header-->
<div class="app-content-header">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="col-sm-6">
                <h3 class="mb-0">Delete</h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item">
                        <a class="btn btn-sm btn-success text-center">
                            <i class="fa-solid fa-house fa-sm"></i>
                            Home
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Index">
                            Product
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Delete
                    </li>
                </ol>
            </div>
        </div> <!--end::Row-->
    </div> <!--end::Container-->
</div> <!--end::App Content Header--> <!--begin::App Content-->
<div class="app-content">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="col-12">
                <!-- Default box -->
                <div class="card">
                    <div class="card-header">
                        <strong>Are you sure to delete this ?</strong>
                    </div>
                    <div class="card-body py-0">
                        <div class="row">
                            <div class="col-9">
                                <table class="table">
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.Name)</th>
                                        <td>@Html.DisplayFor(model => model.Name)</td>
                                    </tr>
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.Slug)</th>
                                        <td>@Html.DisplayFor(model => model.Slug)</td>
                                    </tr>
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.Warranty)</th>
                                        <td>@Html.DisplayFor(model => model.Warranty)</td>
                                    </tr>
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.Status)</th>
                                        <td>
                                            @if (Model.Status != null)
                                            {
                                                var statusValue = Model.Status.Value;
                                                if (ViewBag.StatusDictionary.ContainsKey(statusValue))
                                                {
                                                    @ViewBag.StatusDictionary[statusValue]
                                                }
                                                else
                                                {
                                                    <span>Unknown Status</span>
                                                }
                                            }
                                            else
                                            {
                                                <span>Status not set</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.StatusProduct)</th>
                                        <td>
                                            @if (Model.StatusProduct != null)
                                            {
                                                var statusValue = Model.StatusProduct.Value;
                                                if (ViewBag.StatusProductDictionary.ContainsKey(statusValue))
                                                {
                                                    @ViewBag.StatusProductDictionary[statusValue]
                                                }
                                                else
                                                {
                                                    <span>Unknown Status</span>
                                                }
                                            }
                                            else
                                            {
                                                <span>Status not set</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.Price)</th>
                                        <td>@Html.DisplayFor(model => model.Price)</td>
                                    </tr>
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.Discount)</th>
                                        <td>@Html.DisplayFor(model => model.Discount)</td>
                                    </tr>
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.EndDateDiscount)</th>
                                        <td>@Html.DisplayFor(model => model.EndDateDiscount)</td>
                                    </tr>
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.Views)</th>
                                        <td>@Html.DisplayFor(model => model.Views)</td>
                                    </tr>
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.DateOfManufacture)</th>
                                        <td>@Html.DisplayFor(model => model.DateOfManufacture)</td>
                                    </tr>
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.MadeIn)</th>
                                        <td>@Html.DisplayFor(model => model.MadeIn)</td>
                                    </tr>
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.PromotionalGift)</th>
                                        <td>@Html.DisplayFor(model => model.PromotionalGift)</td>
                                    </tr>
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.CreatedBy)</th>
                                        <td>@Html.DisplayFor(model => model.CreatedBy)</td>
                                    </tr>
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.CreateDate)</th>
                                        <td>@Html.DisplayFor(model => model.CreateDate)</td>
                                    </tr>
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.UpdatedBy)</th>
                                        <td>@Html.DisplayFor(model => model.UpdatedBy)</td>
                                    </tr>
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.UpdateDate)</th>
                                        <td>@Html.DisplayFor(model => model.UpdateDate)</td>
                                    </tr>
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.Description)</th>
                                        <td>@Html.Raw(Model.Description)</td>
                                    </tr>
                                </table>

                                @if (Model.Specifications != null && Model.Specifications.Any())
                                {
                                    <h5 class="mt-4">Specifications</h5>
                                    <table class="table table-bordered">
                                        <thead>
                                            <tr>
                                                <th>Specification Name</th>
                                                <th>Detail</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var spec in Model.Specifications)
                                            {
                                                <tr>
                                                    <td>@spec.SpecName</td>
                                                    <td>@spec.Detail</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <p class="text-muted">No specifications available.</p>
                                }
                            </div>


                            <div class="col-3 text-center">
                                @Html.DisplayNameFor(model => model.Photo)
                                <br />
                                <img src="@Model.Photo" alt="Product Photo" width="150" />
                            </div>
                        </div>
                    </div> <!-- /.card-body -->
                    <div class="card-footer">
                        <form asp-action="Delete">
                            <input type="hidden" asp-for="ProductId" />
                            <button type="submit" value="Delete" class="btn btn-danger text-center">
                                <i class="fa-solid fa-trash fa-sm"></i>
                                Delete
                            </button> |
                            <a asp-action="Index" class="btn btn-sm btn-success text-center" style="padding-bottom: 0.5em; padding-top: 0.5em;">
                                <i class="fa-solid fa-right-from-bracket fa-rotate-180"></i>
                                Back to List
                            </a>
                        </form>
                    </div> <!-- /.card-footer-->
                </div> <!-- /.card -->
            </div>
        </div> <!--end::Row-->
    </div> <!--end::Container-->
</div> <!--end::App Content-->
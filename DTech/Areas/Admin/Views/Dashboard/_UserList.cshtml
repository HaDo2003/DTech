@model dynamic
@{
    var count = Model.Count;
}

<div class="col-md-6">
    <!-- USERS LIST -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Latest Members</h3>

            <div class="card-tools">
                @if(count > 0)
                {
                    <span class="badge text-bg-danger">
                        @count New Members
                    </span>
                }
                <button type="button"
                        class="btn btn-tool"
                        data-lte-toggle="card-collapse">
                    <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                    <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                </button>
                <button type="button"
                        class="btn btn-tool"
                        data-lte-toggle="card-remove">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>
        <!-- /.card-header -->
        <div class="card-body p-0">
            <div class="row text-center m-1">
                @foreach (var customer in Model.Customers)
                {
                    <div class="col-3 p-2">
                        <img class="img-fluid rounded-circle"
                             src="@customer.Image"
                             alt="User Image" />
                        <a class="btn fw-bold fs-7 text-secondary text-truncate w-100 p-0"
                           href="#">
                            @customer.FullName
                        </a>
                        <div class="fs-8">@customer.CreateDate.ToString("d MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</div>
                    </div>
                }
            </div>
            <!-- /.users-list -->
        </div>
        <!-- /.card-body -->
        <div class="card-footer text-center">
            <a href="javascript:" class="link-primary link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover">View All Users</a>
        </div>
        <!-- /.card-footer -->
    </div>
    <!-- /.card -->
</div>
<!-- /.col -->

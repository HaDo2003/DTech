@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<!--begin::App Wrapper-->
<div class="app-wrapper">
    <!--begin::App Main-->
    <main class="app-main">
        <!--begin::App Content Header-->
        <div class="app-content-header">
            <!--begin::Container-->
            <div class="container-fluid">
                <!--begin::Row-->
                <div class="row">
                    <div class="col-sm-6">
                        <h3 class="mb-0">Dashboard</h3>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-end">
                            <li class="breadcrumb-item"><a href="#">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">
                                Dashboard
                            </li>
                        </ol>
                    </div>
                </div>
                <!--end::Row-->
            </div>
            <!--end::Container-->
        </div>
        <div class="app-content">
            <!--begin::Container-->
            <div class="container-fluid">
                <partial name="_InfoBoxes" />
                <partial name="_MonthRecap" />
                <!--begin::Row-->
                <div class="row">
                    <div class="col-lg-6">
                        <partial name="_Visitor" />
                    </div>
                    <!-- /.col-md-6 -->
                    <div class="col-lg-6">
                        @await Html.PartialAsync("_LastestOrder", (IEnumerable<DTech.Models.EF.Order>)ViewBag.Orders)
                    </div>
                    <!-- /.col-md-6 -->
                </div>
                <!--end::Row-->
                <!--begin::Row-->
                <div class="row">
                    <!-- Start col -->
                    <div class="col-md-8">
                        <!--begin::Row-->
                        <div class="row g-4 mb-4">
                            <partial name="_DirectChat" />
                            @await Html.PartialAsync("_UserList", new {
                                Customers = (IEnumerable<DTech.Models.EF.ApplicationUser>)ViewBag.Customers,
                                Count = (int)ViewBag.CountCustomer
                            })
                            @* @await Html.PartialAsync("_UserList", (IEnumerable<DTech.Models.EF.ApplicationUser>)ViewBag.Customers, ViewBag.CountCustomer) *@
                        </div>
                        <!--end::Row-->
                    </div>
                    <!-- /.col -->

                    <div class="col-md-4">
                        @await Html.PartialAsync("_ProductList", (IEnumerable<DTech.Models.EF.Product>)ViewBag.Products)
                    </div>
                    <!-- /.col -->
                </div>
                <!--end::Row-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::App Content-->
    </main>
    <!--end::App Main-->
    <Footer />
</div>
<!--end::App Wrapper-->
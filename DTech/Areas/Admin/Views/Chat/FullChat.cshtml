@model DTech.Models.ViewModel.FullChatViewModel
@{
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}
<div class="card">
    <div class="card-header">
        <div class="d-flex align-items-center">
            <img src="@Model.SenderImageUrl"
                 class="rounded-circle me-2"
                 style="width: 40px; height: 40px; object-fit: cover;" />
            <h3 class="card-title mb-0">@Model.SenderName</h3>
        </div>
    </div>
    <div class="card-body p-0" style="height: 25em;">
        <div id="chat-container" class="p-3 h-100 overflow-auto">
            @foreach (var chat in Model.Messages!.OrderBy(c => c.Timestamp))
            {
                bool isMine = chat.SenderId == currentUserId;
                <div class="d-flex @(isMine ? "justify-content-end" : "justify-content-start") mb-2">
                    <div class="p-2 @(isMine ? "bg-primary text-white" : "bg-secondary-subtle text-dark")"
                         style="max-width: 60%; border-radius: 30px; word-wrap: break-word; overflow-wrap: break-word; hyphens: auto;">
                        @chat.Message
                    </div>
                </div>
            }
        </div>
    </div> <!-- /.card-body -->
    <div class="card-footer">
        <form id="send-message-form" class="pt-2 d-flex" style="gap: 10px;"
              data-userid="@Model.SenderId" data-senderid="@currentUserId">
            <input type="text" name="message" class="form-control" placeholder="Type a message..." required />
            <button type="submit" class="btn btn-primary">Send</button>
        </form>
    </div>
</div> <!-- /.card -->

<script>
    const chatContainer = document.getElementById("chat-container");
    chatContainer.scrollTop = chatContainer.scrollHeight;

    $(document).ready(function () {
        $('#send-message-form').submit(function (e) {
            e.preventDefault();
            const message = $(this).find('input[name="message"]').val();
            const receiverId = $(this).data('userid');
            const senderId = $(this).data('senderid');

            if (!message.trim()) return;

            connection.invoke("SendMessage", receiverId, message)
                .catch(err => console.error(err.toString()));

            // Escape HTML to prevent XSS
            const escapedMessage = $('<div>').text(message).html();

            const msgHtml = `<div class="d-flex justify-content-end mb-2">
                <div class="p-2 bg-primary text-white" style="max-width: 60%; border-radius: 30px; word-wrap: break-word; overflow-wrap: break-word; hyphens: auto;">${escapedMessage}</div>
            </div>`;

            $("#chat-container").append(msgHtml);
            $("#chat-container").scrollTop($("#chat-container")[0].scrollHeight);
            $(this).find('input[name="message"]').val('');
        });
    });
</script>
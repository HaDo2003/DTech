@model DTech.Models.EF.ApplicationUser

@{
    ViewData["Title"] = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.mainPage = "information";
    ViewBag.page = "customer";
}

<div class="row">
    <div class="col-md-12">
        <!--begin::App Content Header-->
        <div class="app-content-header">
            <!--begin::Container-->
            <div class="container-fluid">
                <!--begin::Row-->
                <div class="row">
                    <div class="col-sm-6">
                        <h3 class="mb-0">Edit</h3>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-end">
                            <li class="breadcrumb-item">
                                <a class="btn btn-sm btn-success text-center">
                                    <i class="fa-solid fa-house fa-sm"></i>
                                    Home
                                </a>
                            </li>
                            <li class="breadcrumb-item">
                                <a asp-action="Index">
                                    Customer
                                </a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                Details
                            </li>
                        </ol>
                    </div>
                </div> <!--end::Row-->
            </div> <!--end::Container-->
        </div> <!--end::App Content Header--> <!--begin::App Content-->
        <div class="app-content">
            <!--begin::Container-->
            <div class="container-fluid">
                <!--begin::Row-->
                <div class="row">
                    <div class="col-12">
                        <!-- Default box -->
                        <div class="card">
                            <div class="card-body">
                                <div class="form-group">
                                    <div class="row align-items-center">
                                        <div class="col-lg-2 col-sm-4 text-center">
                                            <img src="@Model.Image" id="imgpreview" class="py-2" alt="" />
                                        </div>
                                    </div>
                                    <input asp-for="ImageUpload" class="form-control custom-photo-input" id="input-file" onchange="img_pathUrl(this)" />
                                    <span asp-validation-for="ImageUpload" class="text-danger"></span>
                                </div>
                                <input type="hidden" asp-for="Image" />

                                <div class="row">
                                    <div class="col">
                                        <div class="form-group">
                                            <label asp-for="UserName" class="control-label"></label>
                                            <input asp-for="UserName" class="form-control" readonly />
                                            <span asp-validation-for="UserName" class="text-danger"></span>
                                        </div>
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col">
                                        <div class="col">
                                            <div class="form-group">
                                                <label asp-for="Gender" class="control-label"></label>
                                                <input asp-for="Gender" class="form-control" readonly />
                                                <span asp-validation-for="Gender" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col">
                                        <div class="form-group">
                                            <label asp-for="DateOfBirth" class="control-label"></label>
                                            <input asp-for="DateOfBirth" class="form-control" readonly />
                                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-6 col-sm-4">
                                        <div class="form-group">
                                            <label asp-for="CreatedBy" class="control-label"></label>
                                            <input asp-for="CreatedBy" class="form-control" readonly />
                                            <span asp-validation-for="CreatedBy" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-lg-6 col-sm-8">
                                        <div class="form-group">
                                            <label asp-for="CreateDate" class="control-label"></label>
                                            <input asp-for="CreateDate" class="form-control" readonly />
                                            <span asp-validation-for="CreateDate" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-6 col-sm-4">
                                        <div class="form-group">
                                            <label asp-for="UpdatedBy" class="control-label"></label>
                                            <input asp-for="UpdatedBy" class="form-control" readonly />
                                            <span asp-validation-for="UpdatedBy" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-lg-6 col-sm-8">
                                        <div class="form-group">
                                            <label asp-for="UpdateDate" class="control-label"></label>
                                            <input asp-for="UpdateDate" class="form-control" readonly />
                                            <span asp-validation-for="UpdateDate" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                            </div> <!-- /.card-body -->
                            <div class="card-footer">
                                <div class="form-group">
                                    <a asp-action="Index" class="btn btn-sm btn-success text-center" style="padding-bottom: 0.5em; padding-top: 0.5em;">
                                        <i class="fa-solid fa-right-from-bracket fa-rotate-180"></i>
                                        Back to List
                                    </a>
                                </div>
                            </div> <!-- /.card-footer-->
                        </div> <!-- /.card -->
                    </div>
                </div> <!--end::Row-->
            </div> <!--end::Container-->
        </div> <!--end::App Content-->
    </div>
</div>

<!-- Include the partial view for customer addresses -->
@await Html.PartialAsync("DetailAddress", Model.CustomerAddresses)

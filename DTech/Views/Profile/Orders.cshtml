@model IEnumerable<DTech.Models.EF.Order>
@{
    ViewBag.Title = "Orders";
    ViewData["ActionName"] = "Orders";
}
@section Head {
    <link href="~/css/datatables.datatables.min.css" rel="stylesheet" />
}
@section Scripts {
    <script src="~/js/datatables.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#myTable').DataTable();
        });
    </script>
}
<div class="table-responsive">
    <table class="table table-bordered table-striped" id="myTable">
        <thead>
            <tr>
                <th class="text-start">@Html.DisplayNameFor(model => model.OrderId)</th>
                <th>@Html.DisplayNameFor(model => model.OrderDate)</th>
                <th class="text-start">@Html.DisplayNameFor(model => model.FinalCost)</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-start">@Html.DisplayFor(modelItem => item.OrderId)</td>
                    <td>@Html.DisplayFor(modelItem => item.OrderDate)</td>
                    <td class="text-start">@Html.DisplayFor(modelItem => item.FinalCost)</td>
                    <td>@Html.DisplayFor(modelItem => item.Status.Description)</td>
                </tr>
            }
        </tbody>
    </table>
</div>



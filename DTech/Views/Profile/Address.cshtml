@model List<DTech.Models.EF.CustomerAddress>
@{
    ViewBag.Title = "Address";
    ViewData["ActionName"] = "Address";
}
<div class="row">
    <div class="col-6 text-start">
        <h4>My Address</h4>
    </div>
    <div class="col-6 text-end">
        <button class="btn btn-danger" onclick="openForm()">
            <i class="fa-solid fa-plus"></i>
            Add new address
        </button>
    </div>
</div>

<hr class="my-4"/>
<partial name="CreateAddress" model="new DTech.Models.EF.CustomerAddress()" />

@if (Model != null && Model.Any())
{

    @foreach (var item in Model)
    {
        <div class="address-card mb-4 border-bottom pb-3">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="mb-0">@item.FullName</h5>
                    <p class="text-secondary mb-1">@item.PhoneNumber</p>
                </div>
                <div>
                    <a href="javascript:void(0);"
                       class="text-primary me-3"
                       onclick="loadEditAddress('@Url.Action("EditAddress", "Profile", new { id = item.AddressId })')">
                        Update
                    </a>

                    <form asp-action="DeleteAddress"
                          asp-route-id="@item.AddressId"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('Are you sure you want to delete this address?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link text-danger p-0 m-0 align-baseline">
                            Delete
                        </button>
                    </form>
                </div>
            </div>

            <div class="address-details mt-2">
                <p class="mb-1">@item.Address, @item.Ward, @item.District, @item.Province</p>
            </div>

            @if (!item.IsDefault)
            {
                <div class="mt-3">
                    <a href="@Url.Action("SetDefaultAddress", "Address", new { id = item.AddressId })"
                       class="btn btn-outline-secondary btn-sm px-3">
                        Set as Default
                    </a>
                </div>
            }
            else
            {
                <div class="mt-2">
                    <span class="badge bg-light text-dark border">Default</span>
                </div>
            }
        </div>
    }

}
else
{
    <p class="text-muted">No addresses found.</p>
}

<!-- Overlay for Edit Address Form -->
<div id="editOverlay" class="overlay d-none">
    <div class="mx-auto d-none" id="editAddressForm" >
        <!-- The EditAddress partial view will be loaded here -->
    </div>
</div>
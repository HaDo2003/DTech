@model DTech.Models.ViewModel.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<h4>Change Passsword</h4>
<form asp-controller="Profile" asp-action="ChangePassword" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row">
            <div class="row m-2">
                <div class="col-3 align-content-center">
                    <label asp-for="CurrentPassword" class="control-label"></label>
                </div>
                <div class="form-group col-9">
                    <input asp-for="CurrentPassword" class="form-control" />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>
            </div>

            <div class="row m-2">
                <div class="col-3 align-content-center">
                    <label asp-for="NewPassword" class="control-label"></label>
                </div>
                <div class="form-group col-9">
                    <input asp-for="NewPassword" class="form-control" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>
            </div>

            <div class="row m-2">
                <div class="col-3 align-content-center">
                    <label asp-for="ConfirmPassword" class="control-label"></label>
                </div>
                <div class="form-group col-9">
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>
    </div>

    <div class="ps-3">
        <button type="submit" value="Save" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk fa-sm"></i>
            Save
        </button>
    </div>
</form>

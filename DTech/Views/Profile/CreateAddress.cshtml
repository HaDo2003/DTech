@model DTech.Models.EF.CustomerAddress

<div id="overlay" class="overlay d-none">
    <div class="mx-auto d-none" id="addressForm">
        <div class="row">
            <div class="col-10">
                <h3 class="text-start py-2">Add New Address</h3>
            </div>
            <div class="col-2 text-end d-flex justify-content-end align-items-center">
                <button id="close" onclick="closeForm()" class="btn btn-outline-danger btn-sm rounded-circle fw-bold button-custom">
                    ×
                </button>
            </div>
        </div>
        <form asp-action="CreateAddress" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row m-2">
                <div class="form-group">
                    <input asp-for="FullName" class="form-control" placeholder="Full Name" required />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
            </div>

            <div class="row m-2">
                <div class="form-group">
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Phone Number" required />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="row m-2">
                <div class="form-group">
                    <select id="province" asp-for="Province" class="form-control" required>
                        <option value="">-- Select Province --</option>
                    </select>
                    <span asp-validation-for="Province" class="text-danger"></span>
                </div>
            </div>

            <div class="row m-2">
                <div class="form-group">
                    <select id="district" asp-for="District" class="form-control" required>
                        <option value="">-- Select District --</option>
                    </select>
                    <span asp-validation-for="District" class="text-danger"></span>
                </div>
            </div>

            <div class="row m-2">
                <div class="form-group">
                    <select id="ward" asp-for="Ward" class="form-control" required>
                        <option value="">-- Select Ward --</option>
                    </select>
                    <span asp-validation-for="Ward" class="text-danger"></span>
                </div>
            </div>

            <div class="row m-2">
                <div class="form-group">
                    <input asp-for="Address" class="form-control" placeholder="Address" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            </div>

            <div class="form-check m-2">
                <input type="checkbox" name="IsDefault" value="true" @(Model.IsDefault == true ? "checked" : "") />
                <label asp-for="IsDefault" class="form-check-label">Set as default address</label>
                <span asp-validation-for="IsDefault" class="text-danger"></span>
            </div>

            <div class="row m-2 text-center align-content-center">
                <div class="form-group">
                    <button type="submit" value="Create" class="btn btn-dark w-100 button-hover">
                        Add Address
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
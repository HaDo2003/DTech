@model DTech.Models.ViewModel.UserViewModel

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-11 col-md-7 col-lg-8 col-xl-5 mx-auto rounded border">
        <h2 class="text-center py-2">Register New Account</h2>
        <form asp-action="Register" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row m-2">
                <div class="form-group">
                    <input asp-for="FullName" class="form-control" placeholder="Full Name" required/>
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
            </div>

            <div class="row m-2">
                <div class="form-group">
                    <input asp-for="Account" class="form-control" placeholder="Account" required />
                    <span asp-validation-for="Account" class="text-danger"></span>
                </div>
            </div>

            <div class="row m-2">
                <div class="form-group">
                    <input asp-for="Email" class="form-control" placeholder="Email" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <div class="row m-2">
                <div class="form-group">
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Phone Number" required />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="row m-2">
                <label asp-for="Gender" class="col-2 col-form-label text-center align-content-center"></label>
                <div class="form-group py-2 custom-radio-container col-10">
                    <div class="custom-radio-group">
                        <div>
                            <input asp-for="Gender" type="radio" value="Male" id="Male" class="custom-radio" required/>
                            <label class="custom-label-radio" for="Male">Male</label>
                        </div>
                        <div>
                            <input asp-for="Gender" type="radio" value="Female" id="Female" class="custom-radio" />
                            <label class="custom-label-radio" for="Female">Female</label>
                        </div>
                        <div>
                            <input asp-for="Gender" type="radio" value="Other" id="Other" class="custom-radio" />
                            <label class="custom-label-radio" for="Other">Other</label>
                        </div>
                    </div>

                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>
            </div>

            <div class="row m-2">
                <div class="form-group">
                    <input asp-for="DateOfBirth" type="date" class="form-control" id="DateOfBirth" placeholder="Date Of Birth" />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>
            </div>

            <div class="row m-2">
                <div class="form-group">
                    <input asp-for="Address" class="form-control" placeholder="Address" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            </div>

            <div class="row m-2">
                <div class="form-group position-relative">
                    <input asp-for="Password" id="password" type="password" class="form-control" placeholder="Password" />
                    <i id="eyeIcon1" class="fa-solid fa-eye position-absolute eye pe-3"
                       onclick="togglePassword('password', 'eyeIcon1')"></i>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
            </div>

            <div class="row m-2">
                <div class="form-group position-relative">
                    <input asp-for="ConfirmPassword" id="cpassword" type="password" class="form-control" placeholder="Confirm Password" />
                    <i id="eyeIcon2" class="fa-solid fa-eye position-absolute eye pe-3"
                       onclick="togglePassword('cpassword', 'eyeIcon2')"></i>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <div class="row m-2 text-center align-content-center">
                <div class="form-group">
                    <button type="submit" value="Create" class="btn btn-dark w-100 button-hover">
                        Register
                    </button>
                </div>
            </div>
        </form>
        <div class="row m-2 text-end">
            <label class="control-label">
                Already have account ? <span><a asp-action="Login" class="click-here">Click here</a></span>
            </label>
        </div>

        <div class="m-2 text-center">
            <div class="d-flex align-items-center m-2">
                <hr class="flex-grow-1">
                <span class="mx-2">Or Sign Up With</span>
                <hr class="flex-grow-1">
            </div>
        </div>

        <div class="d-flex justify-content-between my-2 mx-3 gap-3">
            <div class="flex-fill text-center border border-1 p-2 btn btn-danger">
                <a asp-action="GoogleLogin" class="a-custom-button">
                    <i class="fa-brands fa-google"></i>
                    <label class="control-label">Google</label>
                </a>
            </div>

            <div class="flex-fill text-center border border-1 p-2 btn btn-primary">
                <a asp-action="FacebookLogin" class="a-custom-button">
                    <i class="fa-brands fa-facebook"></i>
                    <label class="control-label">Facebook</label>
                </a>
            </div>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h2 class="text-center mb-0">Access Denied</h2>
                </div>
                <div class="card-body text-center">
                    <i class="fas fa-exclamation-triangle fa-5x text-danger mb-3"></i>
                    <h4>You do not have permission to access this resource.</h4>
                    <p class="mb-4">Please contact your administrator if you believe this is a mistake.</p>
                    <a href="/" class="btn btn-primary">Return to Home</a>
                </div>
            </div>
        </div>
    </div>
</div>

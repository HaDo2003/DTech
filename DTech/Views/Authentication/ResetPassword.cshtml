@model DTech.Models.ViewModel.PasswordViewModel

@{
    ViewData["Title"] = "Authentication Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-5 mx-auto rounded border">
        <h2 class="text-center py-2">Reset Password</h2>
        <form asp-controller="Authentication" asp-action="ResetPassword" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div class="row m-2">
                <div class="form-group position-relative">
                    <input asp-for="NewPassword" id="password" type="password" class="form-control" placeholder="Password" required />
                    <i id="eyeIcon1" class="fa-solid fa-eye position-absolute eye pe-3"
                       onclick="togglePassword('password', 'eyeIcon1')"></i>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>
            </div>

            <div class="row m-2">
                <div class="form-group position-relative">
                    <input asp-for="ConfirmPassword" id="cpassword" type="password" class="form-control" placeholder="Confirm Password" required />
                    <i id="eyeIcon1" class="fa-solid fa-eye position-absolute eye pe-3"
                       onclick="togglePassword('cpassword', 'eyeIcon1')"></i>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <div class="row m-2 text-center align-content-center">
                <div class="form-group">
                    <button type="submit" class="btn btn-dark w-100 button-hover">
                        Reset Password
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@{
    ViewData["Title"] = "Authentication Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-5 mx-auto rounded border">
        <h2 class="text-center py-2">Forgot Password</h2>
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success alert-dismissible fade show text-center m-2" role="alert">
                <strong>@ViewBag.SuccessMessage</strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <form asp-action="ForgotPassword" method="post">
            <div class="m-2">
                <div class="form-group">
                    <input type="text" class="form-control" name="email" value="@ViewBag.Email" placeholder="Email" required />
                    <span class="text-danger">@ViewBag.EmailError</span>
                </div>
            </div>

            <div class="m-2 text-center align-content-center">
                <div class="form-group">
                    <button type="submit" class="btn btn-dark w-100 button-hover">
                        Send Email
                    </button>
                </div>
            </div>
        </form>

        <div class="row m-2">
            <div class="text-center">
                <label class="control-label">
                    <a class="a-custom" href="#">Use Phone Number</a>
                </label>
            </div>
        </div>
    </div>
</div>

@model DTech.Models.ViewModel.CheckoutViewModel

<div class="card card-order mb-4">
    <div class="card-header card-header-order">
        <h5 class="mb-0"><i class="fas fa-credit-card me-2"></i>Payment Method</h5>
    </div>
    <div class="card-body card-body-order">
        @foreach (var payment in Model.PaymentMethods)
        {
            if (payment.Description == "COD")
            {
                <div class="form-check mb-2">
                    <input asp-for="PaymentMethod" class="form-check-input" type="radio" value="@payment.PaymentMethodId" id="payment_@payment.PaymentMethodId" checked>
                    <label class="form-check-label" for="payment_@payment.PaymentMethodId">
                        <strong>@payment.Description</strong>
                    </label>
                </div>
                continue;
            }
            <div class="form-check mb-2">
                <input asp-for="PaymentMethod" class="form-check-input" type="radio" value="@payment.PaymentMethodId" id="payment_@payment.PaymentMethodId">
                <label class="form-check-label" for="payment_@payment.PaymentMethodId">
                    <strong>@payment.Description</strong>
                </label>
            </div>
        }
        <span asp-validation-for="PaymentMethod" class="text-danger"></span>
    </div>
</div>

@model DTech.Models.ViewModel.CheckoutViewModel
@{
    ViewData["Title"] = "CheckOut";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    @Html.AntiForgeryToken()
    <form asp-action="CheckOut" method="post" id="checkoutForm">
        <div class="row">
            <!-- Main Content -->
            <div class="col-lg-8">
                <!-- Billing Information -->
                <div class="card card-order mb-4">
                    <div class="card-header card-header-order">
                        <h5 class="mb-0"><i class="fas fa-user me-2"></i>Order Information</h5>
                    </div>
                    <div class="card-body card-body-order">
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <div class="form-floating">
                                    <select asp-for="CustomerAddress" class="form-select" id="customerAddressSelect" placeholder="Address List">
                                        @foreach (var address in Model.CustomerAddresses)
                                        {
                                            <option value="@address.AddressId">
                                                @address.FullName, @address.Address, @address.Ward?.Name, @address.District?.Name, @address.Province?.Name
                                            </option>
                                        }
                                        <option value="0">Another Address ...</option>
                                    </select>
                                    <label asp-for="CustomerAddress" class="form-label fs-6">Address List</label>
                                </div>
                            </div>

                            <div class="col-md-12 mb-3">
                                <div class="form-floating">
                                    <input asp-for="Email" type="email" class="form-control" readonly>
                                    <label asp-for="Email" class="form-label fs-6">Email</label>
                                </div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="BillingName" type="text" class="form-control" id="billingName" placeholder="Full Name" required>
                                    <label asp-for="BillingName" class="form-label fs-6">Full Name</label>
                                </div>
                                <span asp-validation-for="BillingName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="BillingPhone" type="tel" class="form-control" id="billingPhone" placeholder="Phone Number" required>
                                    <label asp-for="BillingPhone" class="form-label fs-6">Phone Number</label>
                                </div>
                                <span asp-validation-for="BillingPhone" class="text-danger"></span>
                            </div>

                            <div class="col-md-12 mb-3">
                                <div class="form-floating">
                                    <input asp-for="BillingAddress" type="text" class="form-control" id="billingAddress" placeholder="Address" required>
                                    <label asp-for="BillingAddress" class="form-label fs-6">Address</label>
                                </div>
                                <span asp-validation-for="BillingAddress" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <div class="form-floating">
                                    <select asp-for="BillingProvince" class="form-select" id="billingProvince" placeholder="Select Province" required>
                                        <option value=""></option>
                                        <!-- Provinces will be loaded here -->
                                    </select>
                                    <label asp-for="BillingProvince" class="form-label fs-6">Province</label>
                                </div>
                                <span asp-validation-for="BillingProvince" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <div class="form-floating">
                                    <select asp-for="BillingDistrict" class="form-select" id="billingDistrict" placeholder="Select District" required>
                                        <option value=""></option>
                                    </select>
                                    <label asp-for="BillingDistrict" class="form-label fs-6">District</label>
                                </div>
                                <span asp-validation-for="BillingDistrict" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <div class="form-floating">
                                    <select asp-for="BillingWard" class="form-select" id="billingWard" placeholder="Select Ward" required>
                                        <option value=""></option>
                                    </select>
                                    <label asp-for="BillingWard" class="form-label fs-6">Ward</label>
                                </div>
                                <span asp-validation-for="BillingWard" class="text-danger"></span>
                            </div>

                            <div class="col-md-12">
                                <div class="form-check">
                                    <input asp-for="DifferenceAddress" class="form-check-input" type="checkbox" id="differenceAddress">
                                    <label class="form-check-label" for="differenceAddress">
                                        Delivery to another address
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Shipping Information (Hidden by default) -->
                <partial name="_ShippingInformation" model="Model" />

                <!-- Payment Method -->
                <partial name="_PaymentMethod" model="Model" />

                <!-- Note -->
                <div class="card card-order mb-4">
                    <div class="card-body card-body-order">
                        <label asp-for="Note" class="form-label">Note</label>
                        <textarea asp-for="Note" class="form-control" rows="3" placeholder="Note about the order..."></textarea>
                    </div>
                </div>

                <!-- Error Messages -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <div asp-validation-summary="All"></div>
                    </div>
                }
            </div>

            <!-- Order Summary Sidebar -->
            <partial name="_OrderSummary" model="Model" />
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Handle customer address selection
            const customerAddressSelect = document.getElementById('customerAddressSelect');
            const differenceAddressCheckbox = document.getElementById('differenceAddress');
            const shippingSection = document.getElementById('shipping-section');
            const applyDiscountBtn = document.getElementById('applyDiscount');
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            if (shippingSection.style.display === 'none') {
                setShippingFieldsRequired(false);
            }

            // Load address data when customer address is selected
            customerAddressSelect.addEventListener('change', function() {
                const addressId = this.value;
                if (addressId && addressId != '0') {
                    // Fetch address details via AJAX
                    fetch(`/checkout/get-address-details?addressId=${addressId}`)
                        .then(response => response.json())
                        .then(async data => {
                            document.getElementById('billingName').value = data.fullName || '';
                            document.getElementById('billingPhone').value = data.phone || '';
                            document.getElementById('billingAddress').value = data.address || '';

                            // Set province and load districts
                            const billingProvince = document.getElementById('billingProvince');
                            const billingDistrict = document.getElementById('billingDistrict');
                            const billingWard = document.getElementById('billingWard');

                            billingProvince.value = data.provinceId || '';
                            await loadDistricts(data.provinceId, billingDistrict);

                            billingDistrict.value = data.districtId || '';
                            await loadWards(data.districtId, billingWard);

                            billingWard.value = data.wardId || '';
                        })
                        .catch(error => {
                            console.error('Error fetching address details:', error);
                            alert('Can not fetch address, please try again!');
                        });
                } else {
                    document.getElementById('billingName').value = '';
                    document.getElementById('billingPhone').value = '';
                    document.getElementById('billingAddress').value = '';
                    document.getElementById('billingProvince').value = '';
                    document.getElementById('billingDistrict').value = '';
                    document.getElementById('billingWard').value = '';
                }
            });

            // Handle different shipping address checkbox
            if (differenceAddressCheckbox) {
                differenceAddressCheckbox.addEventListener('change', function() {
                    if (this.checked) {
                        shippingSection.style.display = 'block';
                        // Make shipping fields required
                        setShippingFieldsRequired(true);
                    } else {
                        shippingSection.style.display = 'none';
                        // Remove required from shipping fields
                        setShippingFieldsRequired(false);
                        // Clear shipping fields
                        clearShippingFields();
                    }
                });
            }

            // Apply discount code
            if (applyDiscountBtn) {
                applyDiscountBtn.addEventListener('click', function() {
                    const code = document.querySelector('input[name="ReductionCode"]').value.trim();
                    const messageDiv = document.getElementById('discount-message');

                    if (!code) {
                        showDiscountMessage('Please input coupon', 'danger');
                        return;
                    }

                    // Show loading state
                    this.disabled = true;
                    this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Loading...';

                    fetch('/checkout/apply-discount', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'X-Requested-With': 'XMLHttpRequest',
                            'RequestVerificationToken': token
                        },
                        body: 'code=' + encodeURIComponent(code)
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            // Update discount display
                            document.getElementById('discount-row').style.display = 'flex';
                             document.getElementById('discount-amount').textContent = '-' + Number(data.discountAmount).toLocaleString();
                            document.getElementById('total-price').textContent = Number(data.newTotal).toLocaleString();
                            showDiscountMessage(data.message, 'success');
                        } else {
                            showDiscountMessage(data.message, 'danger');
                        }
                    })
                    .catch(error => {
                        console.error('Error applying discount:', error);
                        showDiscountMessage('Error, please try again', 'danger');
                    })
                    .finally(() => {
                        // Reset button state
                        this.disabled = false;
                        this.innerHTML = 'Apply';
                    });
                });
            }

            // Province, District, Ward cascade loading
            setupLocationCascade('billing');
            setupLocationCascade('shipping');

            // Form validation before submit
            const checkoutForm = document.getElementById('checkoutForm');
            if (checkoutForm) {
                checkoutForm.addEventListener('submit', async function (e) {
                    // Prevent default form submission
                    e.preventDefault();

                    if (!validateForm()) return;

                    // Determine selected payment method
                    const selectedMethod = document.querySelector('input[name="PaymentMethod"]:checked')?.value;

                    // Create FormData from the form
                    const formData = new FormData(checkoutForm);

                    try {
                        const response = await fetch('/checkout', {
                            method: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'RequestVerificationToken': token
                            },
                            body: formData
                        });

                        const result = await response.json();
                        console.log(result);

                    if (result.success && result.paymentUrl) {
                        window.location.href = result.paymentUrl;
                    } else if (result.success) {
                        window.location.href = '/checkout/order-success';
                    } else {
                        alert(result.message || 'Order failed. Please try again.');
                    }

                    } catch (err) {
                        console.error('Checkout error:', err);
                        alert('Something went wrong. Please try again.');
                    }
                });
            }

        });

        function loadDistricts(provinceId, selectElement) {
            return fetch(`/api/location/districts/${provinceId}`)
                .then(response => response.json())
                .then(districts => {
                    selectElement.innerHTML = '<option value="">Select district</option>';
                    districts.forEach(district => {
                        const option = document.createElement('option');
                        option.value = district.id;
                        option.text = district.name;
                        selectElement.appendChild(option);
                    });
                });
        }

        function loadWards(districtId, selectElement) {
            return fetch(`/api/location/wards/${districtId}`)
                .then(response => response.json())
                .then(wards => {
                    selectElement.innerHTML = '<option value="">Select ward</option>';
                    wards.forEach(ward => {
                        const option = document.createElement('option');
                        option.value = ward.id;
                        option.text = ward.name;
                        selectElement.appendChild(option);
                    });
                });
        }

        // Initialize provinces on page load
        window.addEventListener('load', function() {
            // Load provinces and set selected value
            loadProvinces().then(() => {
                // Set selected province if exists
                const billingProvince = document.getElementById('billingProvince');
                const billingDistrict = document.getElementById('billingDistrict');
                const billingWard = document.getElementById('billingWard');
                const selectedProvince = '@Model.BillingProvince';
                const selectedDistrict = '@Model.BillingDistrict';
                const selectedWard = '@Model.BillingWard';

                if (selectedProvince) {
                    billingProvince.value = selectedProvince;
                    // Load districts for selected province
                    loadDistricts(selectedProvince, billingDistrict).then(() => {
                        if (selectedDistrict) {
                            billingDistrict.value = selectedDistrict;
                            // Load wards for selected district
                            loadWards(selectedDistrict, billingWard).then(() => {
                                if (selectedWard) {
                                    billingWard.value = selectedWard;
                                }
                            });
                        }
                    });
                }
            });
        });

        function loadProvinces() {
            return fetch('/api/location/provinces')
                .then(response => response.json())
                .then(provinces => {
                    const billingProvince = document.getElementById('billingProvince');
                    const shippingProvince = document.getElementById('shippingProvince');
                    billingProvince.innerHTML = '<option value=""></option>';
                    shippingProvince.innerHTML = '<option value="">Select Province</option>';
                    provinces.forEach(province => {
                        const option1 = document.createElement('option');
                        option1.value = province.id;
                        option1.text = province.name;
                        billingProvince.appendChild(option1);

                        const option2 = document.createElement('option');
                        option2.value = province.id;
                        option2.text = province.name;
                        shippingProvince.appendChild(option2);
                    });
                });
        }
    </script>
}
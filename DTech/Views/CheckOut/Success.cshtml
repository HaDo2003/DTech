@model DTech.Models.EF.Order
@{
    ViewData["Title"] = "Order Success";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bg-light min-vh-100">
    <div class="container">
        <!-- Success Message -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <div class="success-icon">
                            <i class="fas fa-check"></i>
                        </div>
                    </div>
                    <div class="col">
                        <h2 class="text-success mb-2">Thank you for your order</h2>
                        <p class="text-muted mb-1">A confirmation email has been sent to @Model.Email</p>
                        <p class="text-muted mb-0">Please check your email for details</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Purchase Information -->
            <div class="col-lg-4 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="card-title mb-0">Purchase Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <small class="text-muted d-block">Phone</small>
                            <span class="fw-medium">@Model.Phone</span>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted d-block">Email</small>
                            <span class="fw-medium">@Model.Email</span>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted d-block">Payment Method</small>
                            <span class="fw-medium">@Model.Payment!.PaymentMethod!.Description</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Delivery Information -->
            <div class="col-lg-4 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="card-title mb-0">Delivery Information</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.ShippingAddress != null
                             && Model.ShippingWardId != null
                             && Model.ShippingDistrictId != null
                             && Model.ShippingProvinceId != null)
                        {
                            <div class="mb-3">
                                <small class="text-muted d-block">Address</small>
                                <span class="fw-medium">@Model.ShippingAddress</span>
                            </div>
                            <div class="mb-3">
                                <span class="fw-medium">@Model.ShippingWard!.Name, @Model.ShippingDistrict!.Name, @Model.ShippingProvince!.Name</span>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <small class="text-muted d-block">Address</small>
                                <span class="fw-medium">@Model.Address</span>
                            </div>
                            <div class="mb-3">
                                <span class="fw-medium">@Model.Ward!.Name, @Model.District!.Name, @Model.Province!.Name</span>
                            </div>
                        }
                        <div class="mb-3">
                            <small class="text-muted d-block">Shipping Method</small>
                            <span class="fw-medium">Home Delivery</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white">
                        <h5 class="card-title mb-0">Order #@Model.OrderId</h5>
                    </div>
                    <div class="card-body overflow-auto" style="max-height: 150px;">
                        <!-- Product Item -->
                        @foreach (var product in Model.OrderProducts)
                        {
                            <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                                <div class="product-image-placeholder me-3 position-relative rounded overflow-hidden shadow-sm" style="width: 150px; height: 100px;">
                                    <div class="position-absolute end-0 top-0">
                                        <span class="badge bg-primary rounded-pill quantity-display">@product.Quantity</span>
                                    </div>
                                    <img src="@product.Product.Photo" alt="@product.Product.Name"
                                         class="img-fluid object-fit-cover rounded" />
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold mb-1">
                                        @product.Product.Name
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-semibold">
                                        @(string.Format("{0:N0}", product.CostAtPurchase))
                                     </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-white">
                        <!-- Price Breakdown -->
                        <div class="mt-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal</span>
                                <span>@(string.Format("{0:N0}", Model.TotalCost))</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Shipping Fee</span>
                                <span>@(string.Format("{0:N0}", Model.ShippingCost))</span>
                            </div>
                            @if (Model.CostDiscount > 0)
                            {
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Discount</span>
                                    <span class="text-danger">- @(string.Format("{0:N0}", Model.CostDiscount))</span>
                                </div>
                            }
                            <hr>
                            <div class="d-flex justify-content-between fw-bold text-primary fs-5">
                                <span>Total</span>
                                <span>@(string.Format("{0:N0}", Model.FinalCost))</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="text-center mb-5">
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <button class="btn btn-primary btn-lg px-4">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-light">
                        <i class="fas fa-shopping-cart me-2"></i>Continue Shopping
                    </a>
                </button>
                <button class="btn btn-outline-primary btn-lg px-4">
                    <i class="fas fa-print me-2"></i>View Bill
                </button>
            </div>
        </div>
    </div>
</div>

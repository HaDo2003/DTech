@model DTech.Models.ViewModel.CheckoutViewModel

<div class="col-lg-4">
    <div class="card card-order sticky-top">
        <div class="card-header card-header-order">
            <h5 class="mb-0">Order (@Model.OrderSummary.ItemCount products)</h5>
        </div>
        <div class="card-body card-body-order">
            <!-- Product List -->
            @foreach (var item in Model.OrderSummary.Items)
            {
                <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                    <div class="position-relative me-3">
                        <img src="@item.Image" alt="@item.Name" style="width: 60px; height: 60px; object-fit: cover;" class="rounded">
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary">@item.Quantity</span>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="mb-1">@item.Name</h6>
                        @* <small class="text-muted">@item.Color</small> *@
                    </div>
                    <div class="text-end">
                        <strong>@(string.Format("{0:N0}", item.Price))</strong>
                    </div>
                </div>
            }

            <!-- Discount Code -->
            <div class="mb-3">
                <div class="input-group">
                    <input asp-for="ReductionCode" type="text" class="form-control" placeholder="Input Coupon">
                    <button type="button" class="btn btn-outline-primary" id="applyDiscount">Apply</button>
                </div>
                <div id="discount-message" class="mt-2"></div>
            </div>

            <!-- Order Summary -->
            <div class="border-top pt-3">
                <div class="d-flex justify-content-between mb-2">
                    <span>Total Price: </span>
                    <span id="subtotal">@(string.Format("{0:N0}", Model.OrderSummary.SubTotal))</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Shipping Fee:</span>
                    <span id="shipping-fee">@(Model.OrderSummary.ShippingFee > 0 ? Model.OrderSummary.ShippingFee : "Free Ship")</span>
                </div>
                <div class="d-flex justify-content-between mb-2" id="discount-row" style="display: none;">
                    <span>Discount:</span>
                    <span id="discount-amount" class="text-success">-0</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between mb-3">
                    <strong>Final Price:</strong>
                    <strong class="text-primary" id="total-price">
                        @(string.Format("{0:N0}", Model.OrderSummary.Total + (Model.OrderSummary.ShippingFee > 0 ? Model.OrderSummary.ShippingFee : 0)))
                    </strong>
                </div>

                <button type="submit" form="checkoutForm" class="btn btn-primary w-100 mb-2">
                    <i class="fas fa-shopping-cart me-2"></i>Order
                </button>
                <a href="/cart" class="btn btn-outline-secondary w-100">
                    <i class="fas fa-arrow-left me-2"></i>Back to Cart
                </a>
            </div>
        </div>
    </div>
</div>

@model DTech.Models.EF.CartProduct
@{
    var finalPrice = Model.Product!.Price;
    if (Model.Product.Discount!= null && Model.Product.Discount > 0)
    {
        finalPrice *= (1 - Model.Product.Discount / 100m);
    }
    var formattedFinalPrice = string.Format("{0:N0}", finalPrice);
    var priceTotal = finalPrice * Model.Quantity;
    var formattedPriceTotal = string.Format("{0:N0}", priceTotal);
}
<input type="hidden" class="product-id" value="@Model.Product.ProductId" />
<div class="row py-2 align-items-center border-bottom cart-item-row" data-cart-product-id="@Model.Id">
    <div class="col-4 d-flex align-items-center">
        <img src="@Model.Product.Photo" alt="@Model.Product.Name" class="cart-img-custom me-2" />
        <div class="cart-product-name">
            @Model.Product.Name
        </div>
    </div>
    <div class="col-2 text-center">
        <span class="fw-bold small">$@formattedFinalPrice</span>
    </div>
    <div class="col-3 d-flex justify-content-center">
        <div class="cart-quantity-control">
            <button type="button" class="cart-btn-quantity-adjust decreaseQuantity">−</button>
            <input type="text" class="cart-quantity-input quantity" value="@Model.Quantity" readonly />
            <button type="button" class="cart-btn-quantity-adjust increaseQuantity">+</button>
        </div>
    </div>
    <div class="col-2 text-center">
        <span class="fw-semibold small cart-total-price">$@formattedPriceTotal</span>
    </div>
    <div class="col-1 d-flex align-items-end justify-content-end">
        <form asp-controller="Cart" asp-action="RemoveFromCart" asp-route-cartProductId="@Model.Product.ProductId" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn p-0 border-0 bg-transparent">
                <i class="fa-solid fa-trash fa-sm text-muted mb-1 me-1"></i>
            </button>
        </form>
    </div>
</div>
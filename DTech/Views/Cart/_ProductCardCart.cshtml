@model DTech.Models.EF.CartProduct

@{
    var finalPrice = Model.Product!.Price * (1 - Model.Product.Discount / 100m);
    var formattedFinalPrice = string.Format("{0:N0}", finalPrice);
    var priceTotal = finalPrice * Model.Quantity;
    var formattedPriceTotal = string.Format("{0:N0}", priceTotal);
}

<input type="hidden" class="product-id" value="@Model.Product.ProductId" />
<div class="row py-2 align-items-center border-bottom cart-item-row" data-cart-id="@Model.Id">
    <div class="col-4 d-flex align-items-center">
        <img src="@Model.Product.Photo" alt="@Model.Product.Name" class="cart-img-custom me-2" />
        <div class="cart-product-name">
            @Model.Product.Name
        </div>
    </div>
    <div class="col-2 text-center">
        <span class="fw-bold small">$@formattedFinalPrice</span>
    </div>
    <div class="col-3 d-flex justify-content-center">
        <div class="cart-quantity-control">
            <button type="button" class="cart-btn-quantity-adjust decreaseQuantity">−</button>
            <input type="text" class="cart-quantity-input quantity" value="@Model.Quantity" readonly />
            <button type="button" class="cart-btn-quantity-adjust increaseQuantity">+</button>
        </div>
    </div>
    <div class="col-3 text-center">
        <span class="fw-semibold small">$@formattedPriceTotal</span>
    </div>
</div>

@section Script {
    <script>
        $(document).ready(function () {
            $('.cart-item-row').each(function () {
                const row = $(this);
                const cartProductId = row.data('cart-product-id');
                const qtyInput = row.find('.cart-quantity-input');
                const btnDec = row.find('.btn-decrease');
                const btnInc = row.find('.btn-increase');
                const totalSpan = row.find('.cart-total-price');
                const grandTotalSpan = $('#grand-total');

                function updateQty(newQty) {
                    $.post('/Cart/UpdateQuantity', {
                        cartProductId: cartProductId,
                        quantity: newQty
                    }, function (res) {
                        if (res.success) {
                            qtyInput.val(newQty);
                            totalSpan.text(`$${res.itemTotal}`);
                            grandTotalSpan.text(`$${res.cartTotal}`);
                        }
                    });
                }

                btnDec.click(function () {
                    let currentQty = parseInt(qtyInput.val());
                    if (currentQty > 1) updateQty(currentQty - 1);
                });

                btnInc.click(function () {
                    let currentQty = parseInt(qtyInput.val());
                    updateQty(currentQty + 1);
                });
            });
        });
    </script>
}
<div class="header clearfix bg-main">
    <div class="container py-2">
        <div class="row align-items-center">

            <div class="col-md-2 col-lg-2 col-2">
                <a asp-controller="Home" asp-action="Index">
                    <img src="~/img/DTechlogo.png" class="img-logo" alt="DTech logo" />
                </a>
            </div>
            @* <div class="col-md-2 col-lg-2 col-2"> *@
            @*     <img src="~/img/dtechlogosmall.png" class="img-logo-small" alt="DTech logo"/> *@
            @* </div> *@
            <div class="col-md-4 col-lg-4 col-4 mx-auto my-auto search-box">
                <div class="input-group form-container">
                    <input type="text" name="search" class="form-control search-input" placeholder="Search" autocomplete="off" />
                    <span class="input-group-btn">
                        <button class="btn btn-search">
                            <i class="fa-solid fa-magnifying-glass fa-xl"></i>
                        </button>
                    </span>
                </div>
            </div>

            <div class="col-md-6 col-lg-6 col-6">
                <ul class="nav justify-content-start">
                    <li class="nav-item me-2">
                        <a class="nav-link active d-flex align-items-center text-light text-decoration-none" href="#">
                            <div class="me-1">
                                <i class="fa-solid fa-phone fa-xl"></i>
                            </div>

                            <div class="text-light">
                                <p class="mb-0 fontsize">Call to order</p>
                                <strong class="fontsize">1800.1234</strong>
                            </div>
                        </a>
                    </li>

                    <li class="nav-item me-2 mt-2">
                        <a class="nav-link active d-flex align-items-center text-light text-decoration-none" href="#">
                            <div class="me-1">
                                <i class="fa-solid fa-location-dot fa-xl"></i>
                            </div>

                            <div class="text-light">
                                <p class="mb-0 fontsize">Location</p>
                            </div>
                        </a>
                    </li>

                    <li class="nav-item me-2 mt-2">
                        <a asp-controller="Cart" asp-action="Index" class="nav-link active d-flex align-items-center text-light text-decoration-none">
                            <div class="me-1">
                                <i class="fa-solid fa-cart-shopping fa-xl"></i>
                            </div>

                            <div class="text-light">
                                <p class="mb-0 fontsize">Shopping Cart</p>
                            </div>
                        </a>
                    </li>

                    <li class="nav-item me-2 mt-2">
                        <a class="nav-link active d-flex align-items-center text-light text-decoration-none" href="#">
                            <div class="me-1">
                                <i class="fa-solid fa-newspaper fa-xl"></i>
                            </div>

                            <div class="text-light">
                                <p class="mb-0 fontsize">News</p>
                            </div>
                        </a>
                    </li>

                    <li class="nav-item dropdown mt-2">
                        <a class="nav-link dropdown-toggle active d-flex align-items-center text-light text-decoration-none" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
                            <div class="me-1">
                                <i class="fa-solid fa-user fa-xl"></i>
                            </div>

                            <div class="text-light">
                                <p class="mb-0 fontsize">Account</p>
                            </div>
                        </a>
                        <ul class="dropdown-menu">
                            @if (User.Identity?.IsAuthenticated ?? false)
                            {
                                <li><a asp-controller="Profile" asp-action="Index" class="dropdown-item">Profile</a></li>
                                <li><a class="dropdown-item" href="#">Settings</a></li>
                                <li><a asp-controller="Authentication" asp-action="Logout" class="dropdown-item">Logout</a></li>
                            }
                            else
                            {
                                <li><a asp-controller="Authentication" asp-action="Login" class="dropdown-item">Log in</a></li>
                                <li><a asp-controller="Authentication" asp-action="Register" class="dropdown-item">Register</a></li>
                            }
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="mainmenu clearfix bg-main">
    <div class="container">
        <nav class="navbar navbar-expand-lg bg-body-tertiary py-1">
            <div class="container-fluid">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 justify-content-between w-100">
                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="Index" class="nav-link active text-light" aria-current="page">Home</a>
                    </li>

                    <li class="nav-item text-light">
                        <a class="nav-link text-light" href="#">Introduce</a>
                    </li>

                    <li class="nav-item text-light">
                        <a asp-controller="Product" asp-action="Category" asp-route-categorySlug="laptop" class="nav-link text-light">Laptop</a>
                    </li>

                    <li class="nav-item text-light">
                        <a asp-controller="Product" asp-action="Category" asp-route-categorySlug="smart-phone" class="nav-link text-light">Smart Phone</a>
                    </li>

                    <li class="nav-item text-light">
                        <a asp-controller="Product" asp-action="Category" asp-route-categorySlug="tablet" class="nav-link text-light">Tablet</a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-light" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Accessory
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a asp-controller="Product" asp-action="Category" asp-route-categorySlug="mouse" id="mouse" onmouseover="showHover(mouse, mouselist)" class="dropdown-item mouse-custom">Mouse</a>
                                <ul id="mouselist" class="dropdown-menu d-none">
                                    <li><a asp-controller="Product" asp-action="Category" asp-route-categorySlug="wired-mouse" class="dropdown-item">Wired Mouse</a></li>
                                    <li><a asp-controller="Product" asp-action="Category" asp-route-categorySlug="wireless-mouse" class="dropdown-item">Wireless Mouse</a></li>
                                </ul>
                            </li>
                            <li>
                                <a asp-controller="Product" asp-action="Category" asp-route-categorySlug="keyboard" id="keyboard" class="dropdown-item">Keyboard</a>
                                <ul id="keyboardlist" class="dropdown-menu d-none">
                                    <li><a asp-controller="Product" asp-action="Category" asp-route-categorySlug="wired-keyboard" class="dropdown-item">Wired Keyboard</a></li>
                                    <li><a asp-controller="Product" asp-action="Category" asp-route-categorySlug="wireless-keyboard" class="dropdown-item">Wireless Keyboard</a></li>
                                </ul>
                             </li>
                            <li>
                                <a asp-controller="Product" asp-action="Category" asp-route-categorySlug="headphone" id="headphone" class="dropdown-item">Headphone</a>
                                <ul id="headphonelist" class="dropdown-menu d-none">
                                    <li><a asp-controller="Product" asp-action="Category" asp-route-categorySlug="wired-headphone" class="dropdown-item">Wired Headphone</a></li>
                                    <li><a asp-controller="Product" asp-action="Category" asp-route-categorySlug="wireless-headphone" class="dropdown-item">Wireless Headphone</a></li>
                                </ul>
                                </li>
                        </ul>
                    </li>

                    <li class="nav-item text-light">
                        <a class="nav-link text-light" href="#">Policy</a>
                    </li>

                    <li class="nav-item text-light">
                        <a class="nav-link text-light" href="#">Contact</a>
                    </li>
                </ul>
            </div>
        </nav>
    </div>
</div>
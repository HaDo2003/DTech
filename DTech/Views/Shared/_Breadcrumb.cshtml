@{
    var currentPath = Context.Request.Path.ToString();
    var lastSegment = currentPath.Split('/', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();
    var isHome = currentPath == "/" || currentPath.Equals("/Home/Index", StringComparison.OrdinalIgnoreCase);
}

<div class="container my-1">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb pt-1 custom-breadcrumb">
            @if (!isHome)
            {
                <li class="breadcrumb-item ps-2">
                    <a class="breadcrumb-link" href="@Url.Action("Index", "Home")">
                        Home
                    </a>
                </li>
                <li class="breadcrumb-item" aria-current="page">
                    @lastSegment!.TrimStart('/')
                </li>
            }
        </ol>
    </nav>
</div>


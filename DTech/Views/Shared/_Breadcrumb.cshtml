@{
    var segments = Context.Request.Path.ToString()
        .Split('/', StringSplitOptions.RemoveEmptyEntries);

    var isHome = segments.Length == 0;
    var accumulatedPath = "";
}

<div class="container my-1">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb pt-1 custom-breadcrumb">
            @if(!isHome)
            {
                <li class="breadcrumb-item ps-2">
                    <a asp-controller="Home" asp-action="Index" class="breadcrumb-link">Home</a>
                </li>
            }
        
            @for (int i = 0; i < segments.Length; i++)
            {
                var segment = segments[i];
                var displaySegment = string.Join(' ', segments[i]
                    .Split('-')
                    .Select(word => char.ToUpper(word[0]) + word.Substring(1)));

                if (segment.Equals("Authentication", StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                accumulatedPath += $"/{segment}";
                var isLast = i == segments.Length - 1 || segments.Skip(i + 1).All(s => s.Equals("Authentication", StringComparison.OrdinalIgnoreCase));

                if (isLast)
                {
                    <li class="breadcrumb-item breadcrumb-active" aria-current="page">
                        @displaySegment
                    </li>
                }
                else
                {
                    <li class="breadcrumb-item">
                        <a class="breadcrumb-link" href="@accumulatedPath">@displaySegment</a>
                    </li>
                }
            }
        </ol>
    </nav>
</div>
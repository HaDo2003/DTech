<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DTEch</title>
    <link rel="icon" type="image/png" href="~/img/DTechfavicon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DTEch.styles.css" asp-append-version="true" />
    <link href="~/css/datatables.datatables.min.css" rel="stylesheet" />
    <link href="~/css/responsive.css" rel="stylesheet" />
    <script src="https://kit.fontawesome.com/75ef677eac.js" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Head", required: false)

</head>
<body>
    <header>
        <partial name="_Header" />
    </header>

    <div class="container">
        <partial name="_Breadcrumb" />
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <partial name="_Footer" />
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/datatables.min.js"></script>
    <script src="~/js/signalR.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (User?.Identity?.IsAuthenticated == true)
    {
        <script>

            // Set JavaScript authentication indicator
            sessionStorage.setItem('userAuthenticated', 'true');

            // Add a hidden field that can be used to check authentication
            document.addEventListener('DOMContentLoaded', function() {
                const body = document.querySelector('body');
                const authIndicator = document.createElement('div');
                authIndicator.id = 'userAuthenticatedIndicator';
                authIndicator.style.display = 'none';
                body.appendChild(authIndicator);
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

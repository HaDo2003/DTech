@model IEnumerable<DTech.Models.EF.Product>
@{
    var title = ViewBag.SectionTitle as string;
    var slug = ViewBag.SectionTitle.ToLower().Replace(" ", "-") as string;
    var sliderId = "slider_" + Guid.NewGuid().ToString("N");
    var sectionClass = title == "Hot Sales" ? "category-section my-xl-4 my-lg-4 my-2 bg-hot-sales" : "category-section my-xl-4 my-lg-4 my-md-1 my-sm-0 my-1";
    var hotSalesTitle = title == "Hot Sales" ? "text-uppercase fw-bold mb-1 hot-sales-title-custom" : "text-uppercase fw-bold mb-1";
}
<div class="@sectionClass">
    <div class="row">
        <div class="col-6 d-flex align-items-center">
            <h3 class="@hotSalesTitle">@title</h3>
        </div>
        <div class="col-6 d-flex align-items-center justify-content-end p-1 pe-3">
            <a asp-controller="Product" asp-action="Category" asp-route-categorySlug="@slug" class="a-custom mb-0">
                View All
                <i class="fa-solid fa-caret-right"></i>
            </a>
        </div>
    </div>

    <div class="position-relative">
        <!-- Left Arrow -->
        <button class="slider-btn slider-btn-left" onclick="slideLeft('@sliderId')">
            <i class="fa-solid fa-chevron-left"></i>
        </button>

        <!-- Right Arrow -->
        <button class="slider-btn slider-btn-right" onclick="slideRight('@sliderId')">
            <i class="fa-solid fa-chevron-right"></i>
        </button>

        <!-- Scrollable Slider -->
        <div id="@sliderId" class="product-slider d-flex overflow-auto hide-scrollbar">
            @foreach (var product in Model.Take(10))
            {
                <div class="slider-item flex-shrink-0">
                    <partial name="_ProductCard" model="product" />
                </div>
            }
        </div>
    </div>
</div>

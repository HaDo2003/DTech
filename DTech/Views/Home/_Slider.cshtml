@model IEnumerable<DTech.Models.EF.Advertisement>
@{
    var advertisements = ViewBag.Advertisements as List<DTech.Models.EF.Advertisement>;
}

<!--Advertisement-->
<div id="carouselExampleAutoplaying" class="carousel slide mb-0" data-bs-ride="carousel">
    <div class="carousel-indicators">
        @for (int i = 0; i < advertisements?.Count; i++)
        {
            <button type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
        }
    </div>

    <div class="carousel-inner">
        @for (int i = 0; i < advertisements?.Count; i++)
        {
            var slider = advertisements[i];
            <div class="carousel-item @(i == 0 ? "active" : "") c-item">
                <img src="@slider.Image" class="d-block w-100" alt="@slider.Name" />
            </div>
        }
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>

    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>